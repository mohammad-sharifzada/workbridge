# Lokal oder Produktion – PostgreSQL (z. B. Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/workbridge?sslmode=require"

# Mindestens 32 Zeichen – in Produktion neu generieren!
AUTH_SECRET="change-me-to-a-long-random-secret-min-32-chars"

NEXT_PUBLIC_APP_NAME="WorkBridge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# mock = SMS-Code wird in der App angezeigt (für Demo/Präsentation)
SMS_PROVIDER="mock"

# Optional: Twilio für echte SMS
# SMS_PROVIDER="twilio"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional: DeepL für Nachrichtenübersetzung
# DEEPL_API_KEY=

# Optional: OpenAI für den Hilfe-Chatbot (ohne Key funktioniert Wissensbasis trotzdem)
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
