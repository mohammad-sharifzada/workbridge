{
  "name": "workbridge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run db:emit && next build",
    "vercel-build": "npm run build",
    "start": "next start",
    "lint": "eslint --config prog_configs/eslint.config.mjs",
    "db:emit": "prisma contract emit --config prog_configs/prisma.config.ts",
    "db:init": "prisma db init --config prog_configs/prisma.config.ts",
    "db:plan": "prisma migration plan --config prog_configs/prisma.config.ts",
    "db:migrate": "prisma db migrate --config prog_configs/prisma.config.ts --advance-ref db",
    "db:sign": "prisma db sign --config prog_configs/prisma.config.ts",
    "db:verify": "prisma db verify --config prog_configs/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "presentation": "bash scripts/presentation-start.sh"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "dependencies": {
    "@next/env": "16.2.11",
    "@prisma/orm-postgres": "8.0.0-rc.24",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "next-intl": "^4.13.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "temporal-polyfill": "^1.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "8.0.0-rc.34",
    "sass": "^1.108.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
